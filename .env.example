# Copy this file to .env and set values locally.
GEMINI_API_KEY=replace-with-your-gemini-api-key
FLASK_SECRET_KEY=replace-with-a-random-secret
FLASK_DEBUG=0
FLASK_PORT=5000
POLICY_DB_PATH=policy_tracker.db
POLICY_UPLOAD_FOLDER=policy_documents
MAX_UPLOAD_MB=10
# Optional: creates this Admin account on startup if the username does not exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-local-password
